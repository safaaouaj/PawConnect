<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FCFB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FCFB"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🐾 PawConnect"
                android:textColor="#29452D"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded" />

        </LinearLayout>

        <!-- PHOTO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#F8FCFB">

            <ImageView
                android:id="@+id/ivAnimalDetails"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:contentDescription="Photo de l'animal"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery" />

        </FrameLayout>

        <!-- CARTE PRINCIPALE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="-8dp"
            android:background="@drawable/bg_card_blue"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- NOM + FAVORIS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAnimalName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bella"
                    android:textColor="#263B2B"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded" />

                <Button
                    android:id="@+id/btnAddFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_favorite_circle"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="♡"
                    android:textAllCaps="false"
                    android:textColor="#29452D"
                    android:textSize="24sp" />

            </LinearLayout>

            <!-- TYPE -->
            <TextView
                android:id="@+id/tvAnimalType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#EDF2EE"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Chien"
                android:textColor="#637568"
                android:textSize="14sp" />

            <!-- STATUS -->
            <TextView
                android:id="@+id/tvAnimalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#E5F2DF"
                android:padding="10dp"
                android:text="Disponible à l'adoption"
                android:textColor="#527B49"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- DESCRIPTION TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="À propos de l'animal"
                android:textColor="#354435"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded" />

            <!-- DESCRIPTION -->
            <TextView
                android:id="@+id/tvAnimalDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:text="Description de l'animal..."
                android:textColor="#777777"
                android:textSize="15sp" />

            <!-- ADOPTION BUTTON -->
            <Button
                android:id="@+id/btnAdoptAnimal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#B5DFA0"
                android:text="Adopter maintenant"
                android:textAllCaps="false"
                android:textColor="#263B2B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
