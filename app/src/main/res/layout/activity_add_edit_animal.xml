<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EBDD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾 PawConnect"
            android:textColor="#71866A"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ajouter un animal"
            android:textColor="#343A32"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Présentez un animal qui cherche une famille."
            android:textColor="#62665D"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo de l'animal"
                android:textColor="#53634D"
                android:textStyle="bold"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/ivAnimalImage"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="10dp"
                android:background="#E7EDE2"
                android:contentDescription="Photo de l'animal"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera" />

            <Button
                android:id="@+id/btnChooseImage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#A3B69A"
                android:text="Choisir une photo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nom de l'animal"
                android:textColor="#53634D"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAnimalName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card_white"
                android:hint="Exemple : Luna"
                android:padding="12dp"
                android:textColor="#343A32" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Type d'animal"
                android:textColor="#53634D"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spAnimalType"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card_white"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Description"
                android:textColor="#53634D"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAnimalDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card_white"
                android:gravity="top"
                android:hint="Décrivez l'animal, son âge et ses particularités..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#343A32" />

            <Button
                android:id="@+id/btnSaveAnimal"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#A3B69A"
                android:text="Enregistrer l'animal"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
