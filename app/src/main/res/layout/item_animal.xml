<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ivAnimalItem"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:background="#F3EBDD"
        android:contentDescription="Photo de l'animal"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <TextView
        android:id="@+id/tvAnimalItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Nom de l'animal"
        android:textColor="#354435"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tvAnimalItemType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chien • Labrador"
        android:textColor="#888888"
        android:textSize="13sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/tvAnimalItemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#E8F0E5"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="Disponible"
        android:textColor="#54734F"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>