<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EBDD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="🐾"
            android:textSize="55sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Espace Association"
            android:textColor="#71866A"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Rejoignez notre communauté de protection animale"
            android:textColor="#62665D"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Créer un compte association"
                android:textColor="#343A32"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nom de l'association"
                android:textColor="#53634D"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAssociationName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card_white"
                android:hint="Nom de votre association"
                android:padding="12dp"
                android:textColor="#343A32"
                android:autofillHints="organization" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Adresse e-mail"
                android:textColor="#53634D"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAssociationEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card_white"
                android:hint="association@email.com"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="#343A32"
                android:autofillHints="emailAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Téléphone"
                android:textColor="#53634D"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAssociationPhone"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card_white"
                android:hint="Numéro de téléphone"
                android:inputType="phone"
                android:padding="12dp"
                android:textColor="#343A32"
                android:autofillHints="phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Mot de passe"
                android:textColor="#53634D"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAssociationPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card_white"
                android:hint="Créer un mot de passe"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#343A32"
                android:autofillHints="newPassword" />

            <Button
                android:id="@+id/btnAssociationRegister"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#A3B69A"
                android:text="Créer mon compte"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Ensemble, protégeons les animaux ♥"
            android:textColor="#71866A"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
