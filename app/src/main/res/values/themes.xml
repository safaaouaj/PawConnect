<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.PawConnect" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/terracotta</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/sage_green</item>
        <item name="colorOnTertiary">@color/black</item>

        <!-- Fond -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Barres et navigation -->
        <item name="android:statusBarColor">@color/forest_green</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Texte -->
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>

        <!-- Apparence -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background</item>

    </style>

    <style name="Theme.PawConnect" parent="Base.Theme.PawConnect" />

</resources>
